{
  "expo": {
    "name": "Goku",
    "slug": "App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/goku-icon1.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/goku-icon1.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/goku-icon1.png",
        "backgroundColor": "#F26722"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.App"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/goku-icon1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-goku.png",
          "imageWidth": 200
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Goku to use your location to center the map, pin reminders, and alert you when you arrive near a located reminder.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F26722"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
