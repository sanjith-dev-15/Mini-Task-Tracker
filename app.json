{
  "expo": {
    "name": "Goku",
    "slug": "App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/goku-icon1.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/goku-icon1.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/goku-icon1.png",
        "backgroundColor": "#F26722"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.App"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/goku-icon1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon1.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
